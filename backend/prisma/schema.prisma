generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  NINO
  NINA
  DAMA
  CABALLERO
  UNISEX
}

enum Badge {
  NUEVO
  OFERTA
  ULTIMO_PAR
}

// CATEGORIA: cada producto pertenece a una sola (Calzados, Ropa, Accesorios…)
// COLECCION: temporadas o campañas; un producto puede estar en varias (Verano, Invierno…)
enum SectionKind {
  CATEGORIA
  COLECCION
}

// Qué tallas se proponen al crear un producto de esa categoría
enum SizeType {
  CALZADO
  ROPA
  UNICA
}

enum DeliveryMethod {
  DELIVERY_LOCAL
  ENVIO_PROVINCIA
  RECOJO
}

enum PaymentMethod {
  YAPE
  PLIN
  TRANSFERENCIA
  CONTRA_ENTREGA
  TARJETA
}

enum OrderStatus {
  PENDIENTE // pedido creado (su stock queda reservado), aún sin pago verificado
  PAGADO // pago verificado: por la administradora (Yape/Plin) o por la notificación de Izipay
  ENVIADO
  ENTREGADO
  CANCELADO // el stock reservado vuelve al inventario
}

enum Role {
  ADMIN
  CUSTOMER
}

enum ComplaintType {
  RECLAMO // disconformidad con el producto o servicio
  QUEJA // malestar con la atención
}

enum ComplaintStatus {
  PENDIENTE
  ATENDIDO
}

/// Sección de la tienda con página propia (/seccion/slug): categorías y colecciones/temporadas.
model Section {
  id             Int         @id @default(autoincrement())
  name           String
  slug           String      @unique
  kind           SectionKind
  sizeType       SizeType    @default(UNICA)
  coverImage     String?
  heroTitle      String      @default("")
  heroText       String      @default("")
  ctaLabel       String      @default("Ver productos")
  // Las colecciones marcadas aparecen en el carrusel de la página de inicio
  showInCarousel Boolean     @default(false)
  sortOrder      Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  categoryProducts   Product[] @relation("ProductCategory")
  collectionProducts Product[] @relation("ProductCollections")

  @@index([kind, isActive])
}

model Product {
  id            Int              @id @default(autoincrement())
  name          String
  slug          String           @unique
  brand         String?
  description   String           @default("")
  categoryId    Int
  category      Section          @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  collections   Section[]        @relation("ProductCollections")
  gender        Gender           @default(UNISEX)
  price         Decimal          @db.Decimal(10, 2)
  originalPrice Decimal?         @db.Decimal(10, 2)
  badge         Badge?
  images        String[]
  featured      Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variants      ProductVariant[]
  orderItems    OrderItem[]
  favorites     Favorite[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  usSize     String?
  cmSize     String?
  stock      Int         @default(0)
  // Talla "apagada" por la administradora: no se muestra aunque tenga stock
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, size])
}

model Order {
  id             Int            @id @default(autoincrement())
  code           String         @unique // código corto que el cliente escribe en su Yape y viaja por WhatsApp
  // Dueño del pedido. Queda en null si la cuenta se elimina (el pedido se conserva).
  userId         Int?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String
  customerPhone  String
  customerEmail  String?
  deliveryMethod DeliveryMethod
  address        String
  paymentMethod  PaymentMethod? // se define cuando el cliente elige cómo pagar
  notes          String?
  total          Decimal        @db.Decimal(10, 2)
  status         OrderStatus    @default(PENDIENTE)
  receiptUrl     String? // captura del pago por Yape/Plin
  paymentRef     String? // identificador de la transacción en la pasarela (tarjeta)
  paidAt         DateTime?
  // true = las unidades de este pedido ya se descontaron del inventario al crearlo
  stockReserved  Boolean        @default(false)
  // Hasta cuándo se guarda la reserva si el cliente no paga. null = no vence sola.
  reservedUntil  DateTime?
  createdAt      DateTime       @default(now())
  items          OrderItem[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Se guardan copias del nombre/talla/precio para que el historial no cambie
  // si luego se edita o elimina el producto.
  productId   Int?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  size        String
  unitPrice   Decimal         @db.Decimal(10, 2)
  quantity    Int
}

/// Ajustes editables desde el panel (textos, logo, contacto, Yape…). Los valores por
/// defecto viven en src/config/settings.ts; aquí solo se guarda lo que se modificó.
model Setting {
  key   String @id
  value String
}

/// Cuentas: la administradora (role ADMIN) y los clientes (role CUSTOMER).
model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique // siempre en minúsculas
  username        String?   @unique // solo la administradora: alternativa al correo para entrar
  name            String
  phone           String?
  // null = la cuenta solo entra con Google (o aún no definió contraseña)
  passwordHash    String?
  googleId        String?   @unique
  role            Role      @default(CUSTOMER)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  // Bloqueo temporal tras varios intentos fallidos de inicio de sesión
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())

  sessions    Session[]
  resetTokens PasswordResetToken[]
  orders      Order[]
  favorites   Favorite[]

  @@index([role])
}

/// Sesión iniciada. El navegador guarda un valor aleatorio en una cookie httpOnly;
/// aquí solo se guarda su huella (SHA-256), así una copia de la BD no sirve para entrar.
model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Enlace de un solo uso para restablecer la contraseña (se guarda solo su huella).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Favorite {
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

/// Hoja del Libro de Reclamaciones virtual (Código de Protección y Defensa del Consumidor).
model Complaint {
  id              Int             @id @default(autoincrement())
  code            String          @unique // correlativo: LR-2026-000001
  type            ComplaintType
  // Consumidor
  customerName    String
  documentType    String // DNI, CE, Pasaporte
  documentNumber  String
  phone           String
  email           String
  address         String
  guardianName    String? // padre, madre o apoderado si es menor de edad
  // Bien contratado
  itemType        String // PRODUCTO o SERVICIO
  itemDescription String
  amount          Decimal?        @db.Decimal(10, 2)
  orderCode       String?
  // Reclamo
  detail          String
  request         String // lo que pide el consumidor
  // Respuesta del proveedor
  status          ComplaintStatus @default(PENDIENTE)
  response        String?
  respondedAt     DateTime?
  createdAt       DateTime        @default(now())

  @@index([status])
}
