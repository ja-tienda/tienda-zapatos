# --- Base de datos (docker-compose.yml lee este archivo si lo copias a .env) ---
POSTGRES_DB=ja_tienda
POSTGRES_USER=ja_admin
POSTGRES_PASSWORD=ja_tienda_2026
POSTGRES_PORT=5433

# --- Backend (copiar a backend/.env) ---
DATABASE_URL="postgresql://ja_admin:ja_tienda_2026@localhost:5433/ja_tienda?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:5173
# PIN del panel "Acceso Jessica / Admin". Cámbialo antes de publicar la tienda.
ADMIN_PIN=1234
# Clave para firmar la sesión del panel admin. Usa un texto largo y aleatorio.
ADMIN_TOKEN_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Dirección pública del backend. Vacío cuando tienda y API comparten dominio (como en desarrollo).
PUBLIC_URL=
# En producción, detrás de un proxy (Nginx, Render, Railway…): 1. En tu PC: 0.
TRUST_PROXY=0

# Pago con tarjeta (Izipay). Se activa al completar las 4 claves del Back Office Vendedor
# (Configuración > Tienda > Claves de API REST). Vacío = la opción sale como "Próximamente".
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
IZIPAY_HMAC_KEY=

# --- Frontend (copiar a frontend/.env, opcional) ---
# Vacío = usa el proxy de Vite hacia http://localhost:4000
VITE_API_URL=
