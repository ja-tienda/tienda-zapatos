# ══════════════════════════════════════════════════════════════════════════════════════
#  Variables de entorno de J & A. Este archivo es solo una PLANTILLA: no pongas aquí
#  claves reales. En tu PC van en backend/.env; en Railway, en "Variables" de cada servicio.
#  La guía paso a paso está en docs/LANZAMIENTO.md
# ══════════════════════════════════════════════════════════════════════════════════════

# ─── Base de datos local (docker-compose.yml) ───────────────────────────────────────────
# Solo para desarrollo en tu PC. En Railway la base la crea el servicio Postgres.
POSTGRES_DB=ja_tienda
POSTGRES_USER=ja_admin
POSTGRES_PASSWORD=ja_tienda_2026
POSTGRES_PORT=5433


# ─── BACKEND (copiar a backend/.env) ────────────────────────────────────────────────────

# [OBLIGATORIA] Conexión a PostgreSQL.
# Railway: ${{Postgres.DATABASE_URL}} (la dirección privada, no la pública).
DATABASE_URL="postgresql://ja_admin:ja_tienda_2026@localhost:5433/ja_tienda?schema=public"

# [Opcional] Conexión con permisos de administración, usada SOLO para aplicar migraciones al
# arrancar. Permite que DATABASE_URL sea un usuario de permisos mínimos (ver la guía).
MIGRATE_DATABASE_URL=

# [OBLIGATORIA en producción] En Railway debe valer "production": activa https forzado,
# cookies seguras y oculta los detalles técnicos de los errores.
NODE_ENV=development

PORT=4000

# [OBLIGATORIA en producción, con https] Dirección pública de la TIENDA, sin barra final.
# Se usa en los enlaces de los correos, en Google OAuth, en CORS, en CSRF y en el sitemap.
APP_URL=http://localhost:5173

# [Opcional] Dirección pública del BACKEND, solo si el navegador lo llama directo a otro
# dominio (sin reenvío desde la tienda). Con la configuración recomendada se deja vacía.
PUBLIC_URL=

# [Opcional] Otros orígenes autorizados a usar la API, separados por coma (APP_URL ya lo está).
# Útil mientras conviven el dominio de Railway y tu dominio propio.
CORS_ORIGIN=

# Cuántos proxys hay delante del backend. En tu PC: 0. En Railway: 1.
# Se comprueba en el panel: Mi acceso > Estado del servidor (debe mostrar tu IP pública).
TRUST_PROXY=0

# [Opcional] Carpeta de imágenes subidas. En Railway debe ser la ruta del Volume
# (por ejemplo /app/uploads). Sin definir: backend/uploads
UPLOADS_DIR=

# "lax" cuando tienda y API comparten dominio (recomendado). "none" solo si están en dos
# dominios *.up.railway.app distintos: Safari y Chrome pueden bloquear esas cookies.
COOKIE_SAMESITE=lax

# Primera cuenta de administración. Solo se usa si todavía no existe ninguna; en producción
# el servidor no arranca sin ella. Después de entrar, cambia la contraseña desde el panel
# (Mi acceso) y BORRA ADMIN_INITIAL_PASSWORD de las variables.
ADMIN_USERNAME=jessica
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# [Opcional] "Iniciar sesión con Google". Sin estas dos claves el botón no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [Recomendada] Envío de correos con Resend: recuperar contraseña y constancia de reclamos.
# Sin ellas, en desarrollo los correos se imprimen en la consola del backend.
RESEND_API_KEY=
# Ejemplo: J & A <pedidos@tudominio.com>  (el dominio debe estar verificado en Resend)
MAIL_FROM=

# [Opcional] Pago con tarjeta (Izipay). Deben ir las 4 o ninguna. Sin ellas la opción sale
# como "Próximamente". Empieza con las claves de PRUEBA.
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
IZIPAY_HMAC_KEY=


# ─── FRONTEND ───────────────────────────────────────────────────────────────────────────
# Ninguna clave secreta debe ir en el frontend: todo lo que empieza con VITE_ termina dentro
# del JavaScript que descarga el navegador.

# [RECOMENDADA en Railway] Dirección del backend vista desde el servidor del frontend.
# Con ella la tienda reenvía /api y /uploads al backend y el navegador usa un solo dominio.
# Railway: http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:${{backend.PORT}}
BACKEND_URL=

# [Solo en el modo anterior, sin BACKEND_URL] Dirección pública del backend. No es un secreto.
# Con BACKEND_URL definida debe quedar VACÍA (o borrarse) y hay que volver a desplegar.
VITE_API_URL=
