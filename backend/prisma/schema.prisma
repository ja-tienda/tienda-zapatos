generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  NINO
  NINA
  DAMA
  CABALLERO
  UNISEX
}

enum Badge {
  NUEVO
  OFERTA
  ULTIMO_PAR
}

// CATEGORIA: cada producto pertenece a una sola (Calzados, Ropa, Accesorios…)
// COLECCION: temporadas o campañas; un producto puede estar en varias (Verano, Invierno…)
enum SectionKind {
  CATEGORIA
  COLECCION
}

// Qué tallas se proponen al crear un producto de esa categoría
enum SizeType {
  CALZADO
  ROPA
  UNICA
}

enum DeliveryMethod {
  DELIVERY_LOCAL
  ENVIO_PROVINCIA
  RECOJO
}

enum PaymentMethod {
  YAPE
  PLIN
  TRANSFERENCIA
  CONTRA_ENTREGA
  TARJETA
}

enum OrderStatus {
  PENDIENTE // pedido creado, aún sin pago verificado
  CONFIRMADO // pago verificado (por Jessica o por la pasarela): aquí se descuenta el stock
  CANCELADO
}

/// Sección de la tienda con página propia (/seccion/slug): categorías y colecciones/temporadas.
model Section {
  id             Int         @id @default(autoincrement())
  name           String
  slug           String      @unique
  kind           SectionKind
  sizeType       SizeType    @default(UNICA)
  coverImage     String?
  heroTitle      String      @default("")
  heroText       String      @default("")
  ctaLabel       String      @default("Ver productos")
  // Las colecciones marcadas aparecen en el carrusel de la página de inicio
  showInCarousel Boolean     @default(false)
  sortOrder      Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  categoryProducts   Product[] @relation("ProductCategory")
  collectionProducts Product[] @relation("ProductCollections")

  @@index([kind, isActive])
}

model Product {
  id            Int              @id @default(autoincrement())
  name          String
  slug          String           @unique
  brand         String?
  description   String           @default("")
  categoryId    Int
  category      Section          @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: Restrict)
  collections   Section[]        @relation("ProductCollections")
  gender        Gender           @default(UNISEX)
  price         Decimal          @db.Decimal(10, 2)
  originalPrice Decimal?         @db.Decimal(10, 2)
  badge         Badge?
  images        String[]
  featured      Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  variants      ProductVariant[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  size       String
  usSize     String?
  cmSize     String?
  stock      Int         @default(0)
  // Talla "apagada" por la administradora: no se muestra aunque tenga stock
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, size])
}

model Order {
  id             Int            @id @default(autoincrement())
  code           String         @unique // código corto que el cliente escribe en su Yape y viaja por WhatsApp
  // Clave secreta que solo conoce el navegador del cliente: le permite ver y pagar SU pedido
  publicToken    String         @default("")
  customerName   String
  customerPhone  String
  customerEmail  String?
  deliveryMethod DeliveryMethod
  address        String
  paymentMethod  PaymentMethod? // se define cuando el cliente elige cómo pagar
  notes          String?
  total          Decimal        @db.Decimal(10, 2)
  status         OrderStatus    @default(PENDIENTE)
  receiptUrl     String? // captura del pago por Yape/Plin
  paymentRef     String? // identificador de la transacción en la pasarela (tarjeta)
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  items          OrderItem[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Se guardan copias del nombre/talla/precio para que el historial no cambie
  // si luego se edita o elimina el producto.
  productId   Int?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  size        String
  unitPrice   Decimal         @db.Decimal(10, 2)
  quantity    Int
}

/// Ajustes editables desde el panel (textos, logo, contacto, Yape…). Los valores por
/// defecto viven en src/config/settings.ts; aquí solo se guarda lo que se modificó.
model Setting {
  key   String @id
  value String
}
